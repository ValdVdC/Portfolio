---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Desenvolvedor Full Stack" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<script is:inline>
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'dark'; // Padrão original do portfólio
			};
			const theme = getTheme();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="bg-background text-text-high font-['Inter'] selection:bg-accent/30 overflow-x-hidden antialiased">


		<!-- Scroll Progress Bar -->
		<div id="scroll-progress" class="fixed top-0 left-0 h-[3px] bg-accent z-[9995] w-0 transition-all duration-75 ease-out"></div>
		<!-- Background Effects -->
		<div class="fixed inset-0 z-[-1] pointer-events-none">
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-accent/5 blur-[120px]"></div>
			<div class="absolute bottom-[10%] right-[-5%] w-[30%] h-[30%] rounded-full bg-accent/10 blur-[100px]"></div>
		</div>

		<!-- Fixed Sidebars (Desktop only) -->
		<div class="fixed left-6 lg:left-12 bottom-0 z-50 hidden md:flex flex-col items-center gap-6 after:content-[''] after:w-[1px] after:h-24 after:bg-text-muted/30">
			<a href="https://github.com/ValdVdC" target="_blank" aria-label="Meu perfil no GitHub" class="magnetic text-text-muted hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.5 2-4.5-2-7-2"/></svg>
			</a>
			<a href="https://linkedin.com/in/osvaldo-vasconcelos/" target="_blank" aria-label="Meu perfil no LinkedIn" class="magnetic text-text-muted hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
			</a>
			<a href="https://www.instagram.com/osvaldovdc/" target="_blank" aria-label="Meu perfil no Instagram" class="magnetic text-text-muted hover:text-accent transition-colors mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
			</a>
		</div>

		<div class="fixed right-6 lg:right-12 bottom-0 z-50 hidden md:flex flex-col items-center gap-6 after:content-[''] after:w-[1px] after:h-24 after:bg-text-muted/30">
			<a href="mailto:osvaldodecarvalho2005@outlook.com" aria-label="Enviar um e-mail para Osvaldo" class="magnetic text-text-muted hover:text-accent transition-colors [writing-mode:vertical-rl] text-sm font-mono tracking-widest mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm">
				osvaldodecarvalho2005@outlook.com
			</a>
		</div>

		<!-- Cmd+K Menu -->
		<div id="cmd-menu" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200">
			<div class="absolute inset-0 bg-background/80 backdrop-blur-sm" id="cmd-backdrop"></div>
			<div class="bg-surface border border-white/10 w-full max-w-lg rounded-xl shadow-2xl z-10 overflow-hidden transform scale-95 transition-transform duration-200" id="cmd-modal">
				<div class="p-4 border-b border-white/5 flex items-center gap-3">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
					<input type="text" id="cmd-input" placeholder="Buscar (Ex: projetos, currículo)" class="w-full bg-transparent outline-none text-text-high placeholder:text-text-muted font-mono text-sm" autocomplete="off" spellcheck="false" />
					<kbd class="hidden sm:inline-block px-2 py-1 bg-background rounded text-xs font-mono text-text-muted border border-white/5">ESC</kbd>
				</div>
				<div class="p-2 max-h-[60vh] overflow-y-auto">
					<p class="text-xs font-mono text-text-muted px-3 py-2 uppercase tracking-wider">Navegação</p>
					<a href="/#about" class="cmd-item flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
						Sobre Mim
					</a>
					<a href="/#skills" class="cmd-item flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m7 19 5 3 5-3"/></svg>
						Habilidades
					</a>
					<a href="/#projects" class="cmd-item flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
						Projetos
					</a>
					<a href="/#contact" class="cmd-item flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
						Contato
					</a>
					<div class="h-[1px] bg-white/5 my-2 mx-2"></div>
					<p class="text-xs font-mono text-text-muted px-3 py-2 uppercase tracking-wider">Ações</p>
					<a href="/curriculo.pdf" target="_blank" class="cmd-item flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
						Baixar Currículo
					</a>
					<button id="cmd-copy-email-btn" class="cmd-item w-full text-left flex items-center gap-3 px-3 py-3 rounded-lg text-text-high hover:bg-white/5 hover:text-accent transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
						<span>Copiar E-mail</span>
					</button>
				</div>
			</div>
		</div>

		<slot />

		<script is:inline>
			// Progress Bar
			const progressBar = document.getElementById('scroll-progress');
			window.addEventListener('scroll', () => {
				if(progressBar) {
					const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
					const scrolled = (window.scrollY / scrollHeight) * 100;
					progressBar.style.width = `${scrolled}%`;
				}
			});

			// Cmd+K Logic
			const cmdMenu = document.getElementById('cmd-menu');
			const cmdModal = document.getElementById('cmd-modal');
			const cmdBackdrop = document.getElementById('cmd-backdrop');
			const cmdInput = document.getElementById('cmd-input');
			const cmdItems = document.querySelectorAll('.cmd-item');
			
			const toggleCmdMenu = () => {
				const isClosed = cmdMenu.classList.contains('opacity-0');
				if (isClosed) {
					cmdMenu.classList.remove('opacity-0', 'pointer-events-none');
					cmdModal.classList.remove('scale-95');
					cmdModal.classList.add('scale-100');
					setTimeout(() => cmdInput?.focus(), 100);
				} else {
					cmdMenu.classList.add('opacity-0', 'pointer-events-none');
					cmdModal.classList.add('scale-95');
					cmdModal.classList.remove('scale-100');
					if(cmdInput) cmdInput.value = '';
					cmdItems.forEach(item => item.style.display = 'flex');
				}
			};

			cmdInput?.addEventListener('input', (e) => {
				const term = e.target.value.toLowerCase();
				cmdItems.forEach(item => {
					const text = item.innerText.toLowerCase();
					if(text.includes(term)) {
						item.style.display = 'flex';
					} else {
						item.style.display = 'none';
					}
				});
			});

			document.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
					e.preventDefault();
					toggleCmdMenu();
				}
				if (e.key === 'Escape' && !cmdMenu.classList.contains('opacity-0')) {
					toggleCmdMenu();
				}
			});

			cmdBackdrop?.addEventListener('click', toggleCmdMenu);
			
			document.querySelectorAll('.cmd-item[href]').forEach(item => {
				item.addEventListener('click', toggleCmdMenu);
			});

			const cmdCopy = document.getElementById('cmd-copy-email-btn');
			cmdCopy?.addEventListener('click', () => {
				navigator.clipboard.writeText('osvaldodecarvalho2005@outlook.com');
				const span = cmdCopy.querySelector('span');
				if(span) {
					const originalText = span.innerText;
					span.innerText = 'Copiado!';
					span.classList.add('text-accent');
					setTimeout(() => {
						span.innerText = originalText;
						span.classList.remove('text-accent');
						toggleCmdMenu();
					}, 1000);
				}
			});

			// Magnetic Elements
			const magnetics = document.querySelectorAll('.magnetic');
			magnetics.forEach((el) => {
				el.addEventListener('mousemove', (e) => {
					const rect = el.getBoundingClientRect();
					const h = rect.width / 2;
					const v = rect.height / 2;
					const x = e.clientX - rect.left - h;
					const y = e.clientY - rect.top - v;
					
					el.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
				});
				
				el.addEventListener('mouseleave', () => {
					el.style.transform = `translate(0px, 0px)`;
					el.style.transition = `transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)`;
				});
				
				el.addEventListener('mouseenter', () => {
					el.style.transition = `transform 0.1s ease-out`;
				});
			});
		</script>

		<script>
			import Lenis from 'lenis';

			// Initialize Lenis Smooth Scroll
			const lenis = new Lenis({
				autoRaf: true,
			});


		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-background: 255 255 255;
		--color-surface: 243 244 246;
		--color-accent: 16 185 129;
		--color-text-high: 17 24 39;
		--color-text-muted: 107 114 128;
		color-scheme: light;
	}
	
	:root.dark {
		--color-background: 10 15 20;
		--color-surface: 22 27 34;
		--color-accent: 16 185 129;
		--color-text-high: 240 246 252;
		--color-text-muted: 156 163 175;
		color-scheme: dark;
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}

	::view-transition-old(root) {
		z-index: 1;
	}

	::view-transition-new(root) {
		z-index: 9999;
	}

	.dark::view-transition-old(root) {
		z-index: 9999;
	}

	.dark::view-transition-new(root) {
		z-index: 1;
	}
	* {
		scrollbar-width: thin;
		scrollbar-color: #10B981 rgba(0,0,0,0);
	}
	
	/* Focus global visibility */
	:focus-visible {
		outline: 2px solid #10B981;
		outline-offset: 4px;
		border-radius: 4px;
	}

	/* Reveal on Scroll */
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Spotlight Effect */
	.spotlight-card {
		position: relative;
		overflow: hidden;
	}
	.spotlight-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(
			800px circle at var(--mouse-x, 0) var(--mouse-y, 0), 
			rgba(16, 185, 129, 0.06),
			transparent 40%
		);
		pointer-events: none;
		z-index: 0;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.spotlight-card:hover::before {
		opacity: 1;
	}
</style>
