---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Osvaldo Vasconcelos | Software Developer">
	<main class="max-w-7xl 2xl:max-w-[1400px] mx-auto px-6 md:px-12">
		<!-- Navigation -->
		<nav class="flex justify-between items-center py-8">
			<div class="text-2xl font-bold text-accent tracking-tighter">OSVALDO</div>
			<div class="hidden md:flex gap-8 text-sm font-medium text-text-muted uppercase tracking-widest items-center">
				<a href="#about" class="hover:text-accent transition-colors">Sobre</a>
				<a href="#skills" class="hover:text-accent transition-colors">Habilidades</a>
				<a href="#projects" class="hover:text-accent transition-colors">Projetos</a>
				<a href="#contact" class="hover:text-accent transition-colors">Contato</a>
				<button id="theme-toggle" aria-label="Alternar Tema" class="magnetic w-10 h-10 flex items-center justify-center rounded-full bg-surface border border-white/5 hover:border-accent/30 text-text-high transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
				</button>
			</div>
			<button class="md:hidden text-accent">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
			</button>
		</nav>

		<!-- Hero Section -->
		<section class="min-h-[90vh] flex flex-col justify-center items-start">
			<h1 class="text-5xl md:text-8xl font-bold tracking-tight mb-4 text-text-high leading-none mt-12">
				Osvaldo Vasconcelos.
			</h1>
			<h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-8 text-text-muted leading-none scramble">
				Desenvolvedor Full Stack.
			</h2>
			<p class="text-lg md:text-xl text-text-muted max-w-2xl mb-12 leading-relaxed">
				Estudante de Ciência da Computação e Desenvolvedor Full Stack. Focado em criar aplicações web eficientes e bem estruturadas, unindo base teórica e prática com <span class="text-accent">React, Node.js e PostgreSQL</span>.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 flex-wrap">
				<a href="#projects" class="magnetic inline-block border-2 border-accent text-accent px-8 py-4 rounded font-mono hover:bg-accent/10 transition-all text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
					Ver Projetos
				</a>
				<a href="/curriculo.pdf" target="_blank" aria-label="Baixar Currículo em PDF" class="magnetic inline-flex justify-center items-center gap-2 border-2 border-surface text-text-high px-8 py-4 rounded font-mono hover:border-text-muted transition-all text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
					Currículo
				</a>
				<a href="#contact" class="magnetic inline-block bg-surface px-8 py-4 rounded font-mono text-text-high hover:brightness-125 transition-all text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
					Contato
				</a>
			</div>
		</section>

		<!-- About Section -->
		<section id="about" class="py-32 reveal">
			<h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
				<span class="text-accent font-mono text-xl">01.</span> 
				Sobre Mim
				<span class="hidden sm:block h-[1px] bg-surface flex-grow max-w-xs"></span>
			</h2>
			<div class="grid md:grid-cols-5 gap-12">
				<div class="md:col-span-3 space-y-6 text-text-muted text-lg leading-relaxed">
					<p>
						Sou estudante de Ciência da Computação e <span class="text-text-high">Desenvolvedor Full Stack apaixonado por tecnologia</span>. Minha formação acadêmica me proporciona uma base sólida nos fundamentos da computação, essencial para resolver problemas complexos com eficiência.
					</p>
					<p>
						Tenho vivência prática no ecossistema <span class="text-text-high">TypeScript, Node.js e React/Next.js</span>, atuando no desenvolvimento tanto do front-end quanto do back-end. Meu principal objetivo é aplicar boas práticas de engenharia de software para entregar projetos de alta qualidade e fácil manutenção.
					</p>
					<p>
						Minha stack de foco atual em produção:
					</p>
					<ul class="grid grid-cols-2 gap-2 font-mono text-sm text-accent">
						<li>▹ React & Next.js</li>
						<li>▹ JavaScript / TypeScript</li>
						<li>▹ Java / Spring Boot</li>
						<li>▹ Python</li>
						<li>▹ C#</li>
						<li>▹ Angular & RxJS</li>
						<li>▹ Node.js & Express</li>
						<li>▹ PostgreSQL & MongoDB</li>
						<li>▹ Docker & CI/CD</li>
					</ul>
				</div>
				<div class="md:col-span-2 flex items-center justify-center">
					<div class="relative w-full max-w-[300px] aspect-square">
						<div class="absolute inset-0 border-2 border-accent rounded-lg translate-x-4 translate-y-4"></div>
						<div class="absolute inset-0 bg-surface rounded-lg border border-white/10 flex items-center justify-center overflow-hidden">
							<div class="text-accent opacity-20 transform -rotate-12 scale-150">
								<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
							</div>
							<div class="absolute inset-0 flex items-center justify-center">
								<span class="text-sm font-mono text-accent">SOFTWARE_DEVELOPER</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills Section -->
		<section id="skills" class="py-32 reveal">
			<h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
				<span class="text-accent font-mono text-xl">02.</span> 
				Expertise Técnica
				<span class="hidden sm:block h-[1px] bg-surface flex-grow max-w-xs"></span>
			</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="spotlight-card p-8 bg-surface border border-white/5 rounded-xl hover:border-accent/30 transition-colors group">
					<h3 class="text-lg font-bold mb-6 flex items-center gap-3">
						<span class="text-accent font-mono group-hover:translate-x-1 transition-transform">/</span> Frontend
					</h3>
					<ul class="space-y-3 text-text-muted text-xs">
						<li>▹ React & Next.js</li>
						<li>▹ Angular & RxJS</li>
						<li>▹ TypeScript / JS</li>
						<li>▹ Tailwind & Astro</li>
					</ul>
				</div>
				<div class="spotlight-card p-8 bg-surface border border-white/5 rounded-xl hover:border-accent/30 transition-colors group">
					<h3 class="text-lg font-bold mb-6 flex items-center gap-3">
						<span class="text-accent font-mono group-hover:translate-x-1 transition-transform">/</span> Backend
					</h3>
					<ul class="space-y-3 text-text-muted text-xs">
						<li>▹ Node.js & Express</li>
						<li>▹ Java / Spring Boot</li>
						<li>▹ Python</li>
						<li>▹ C#</li>
					</ul>
				</div>
				<div class="spotlight-card p-8 bg-surface border border-white/5 rounded-xl hover:border-accent/30 transition-colors group">
					<h3 class="text-lg font-bold mb-6 flex items-center gap-3">
						<span class="text-accent font-mono group-hover:translate-x-1 transition-transform">/</span> Data & Ops
					</h3>
					<ul class="space-y-3 text-text-muted text-xs">
						<li>▹ PostgreSQL & MySQL</li>
						<li>▹ MongoDB (NoSQL)</li>
						<li>▹ Docker</li>
						<li>▹ CI/CD Pipelines</li>
					</ul>
				</div>
				<div class="spotlight-card p-8 bg-surface border border-white/5 rounded-xl hover:border-accent/30 transition-colors group">
					<h3 class="text-lg font-bold mb-6 flex items-center gap-3">
						<span class="text-accent font-mono group-hover:translate-x-1 transition-transform">/</span> Tools
					</h3>
					<ul class="space-y-3 text-text-muted text-xs">
						<li>▹ Git / GitHub</li>
						<li>▹ Metodologias Ágeis</li>
						<li>▹ QA & Unit Testing</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Projects Section -->
		<section id="projects" class="py-32 reveal">
			<h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
				<span class="text-accent font-mono text-xl">03.</span> 
				Projetos em Destaque
				<span class="hidden sm:block h-[1px] bg-surface flex-grow max-w-xs"></span>
			</h2>
			
			<div class="flex flex-col gap-40">
				{[
					{
						title: '2Z - Game Discovery Hub',
						description: 'Plataforma avançada de exploração de jogos construída para performance. Implementa sistemas de cache inteligentes e resiliência de rede para lidar com grandes volumes de dados de APIs externas.',
						achievements: [
							'Arquitetura em camadas com separação clara de responsabilidades.',
							'Sistema de cache customizado reduzindo em 60% as chamadas à API IGDB.',
							'Lógica de retry automático para requisições com falha, garantindo estabilidade.',
							'Frontend reativo com busca dinâmica utilizando RxJS e debounce.'
						],
						tech: ['Angular', 'Node.js', 'Express', 'MongoDB', 'RxJS'],
						link: 'https://front-end-game-hub.vercel.app/',
						github: [
							{ label: 'Front-end', url: 'https://github.com/ValdVdC/FrontEnd-GameHUB' },
							{ label: 'Back-end', url: 'https://github.com/ValdVdC/BackEnd-GameHUB' }
						],
						image: '/images/projects/2z/home.png'
					},
					{
						title: '2ZWatch - Streaming Analytics',
						description: 'Ecossistema completo para monitoramento e descoberta de conteúdo cinematográfico. Focado em segurança e gerenciamento de estado complexo.',
						achievements: [
							'Autenticação segura via Google OAuth 2.0.',
							'Sistema de favoritos e watchlist persistente com alta consistência.',
							'Cache inteligente para otimização de requisições à TMDB API.',
							'Gerenciamento de estado global no frontend Angular para sincronização em tempo real.'
						],
						tech: ['Angular', 'Express', 'MongoDB', 'OAuth 2.0', 'TMDB API'],
						link: 'https://twozwatch.vercel.app',
						github: [
							{ label: 'Client', url: 'https://github.com/ValdVdC/2ZWatch-Client' },
							{ label: 'Server', url: 'https://github.com/ValdVdC/2ZWatch-Server' }
						],
						image: '/images/projects/2zwatch/home.png'
					}
				].map((project, i) => (
					<div class={`relative grid md:grid-cols-12 items-center gap-8 ${i % 2 !== 0 ? 'md:text-right' : ''}`}>
						<!-- Project Image -->
						<div class={`tilt-card md:col-span-7 ${i % 2 !== 0 ? 'md:order-2' : ''} group relative overflow-hidden rounded-xl border border-white/5 bg-background`}>
							<div class="absolute inset-0 bg-background/40 group-hover:bg-transparent transition-all z-10"></div>
							<img src={project.image} alt={`Captura de tela da interface do projeto ${project.title}`} class="w-full aspect-video object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700" />
						</div>
						
						<!-- Project Content -->
						<div class={`md:col-span-6 z-20 ${i % 2 !== 0 ? 'md:col-start-1 md:text-left' : 'md:col-start-7 md:-ml-12 md:text-right'}`}>
							<p class="text-accent font-mono text-sm mb-2">Featured Project</p>
							<h3 class="text-2xl font-bold mb-4 text-text-high">
								<a href={project.link} target="_blank" class="hover:text-accent transition-colors">{project.title}</a>
							</h3>
							<div class="bg-surface p-6 rounded-lg shadow-2xl border border-white/5 mb-6 text-left">
								<p class="text-text-muted mb-4 text-sm md:text-base">{project.description}</p>
								<ul class="space-y-2">
									{project.achievements.map(a => (
										<li class="flex items-start gap-2 text-xs text-text-muted">
											<span class="text-accent mt-0.5">▹</span>
											<span>{a}</span>
										</li>
									))}
								</ul>
							</div>
							<ul class={`flex flex-wrap gap-4 font-mono text-xs text-text-muted mb-8 ${i % 2 !== 0 ? 'md:justify-start' : 'md:justify-end'}`}>
								{project.tech.map(t => <li>{t}</li>)}
							</ul>
							<div class={`flex gap-4 ${i % 2 !== 0 ? 'md:justify-start' : 'md:justify-end'} items-center`}>
								{project.github && project.github.map(gh => (
									<a href={gh.url} target="_blank" aria-label={`Repositório do ${gh.label}`} class="flex items-center gap-2 text-text-muted hover:text-text-high p-2 hover:bg-surface rounded-full transition-all text-xs font-mono">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.5 2-4.5-2-7-2"/></svg>
										<span class="hidden sm:inline">{gh.label}</span>
									</a>
								))}
								<a href={project.link} target="_blank" aria-label="Visitar Projeto" class="text-text-high hover:text-accent p-2 hover:bg-surface rounded-full transition-all">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
								</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Contact Section -->
		<section id="contact" class="py-32 max-w-2xl mx-auto reveal">
			<div class="text-center mb-12">
				<span class="text-accent font-mono text-sm mb-4 block underline">04. Contato</span>
				<h2 class="text-4xl md:text-6xl font-bold mb-8 text-text-high">Mande uma mensagem</h2>
				<p class="text-text-muted text-lg mb-8 leading-relaxed">
					Sinta-se à vontade para entrar em contato sobre oportunidades de trabalho, dúvidas sobre meus projetos ou conexões profissionais.
				</p>
			</div>

			<form name="contact" method="POST" data-netlify="true" class="grid gap-4">
				<input type="hidden" name="form-name" value="contact" />
				<div class="grid md:grid-cols-2 gap-4">
					<input type="text" name="name" aria-label="Nome" placeholder="Nome" required class="bg-surface border border-white/10 p-4 rounded focus:border-accent focus:ring-1 focus:ring-accent outline-none text-text-high transition-all" />
					<input type="email" name="email" aria-label="E-mail" placeholder="E-mail" required class="bg-surface border border-white/10 p-4 rounded focus:border-accent focus:ring-1 focus:ring-accent outline-none text-text-high transition-all" />
				</div>
				<textarea name="message" aria-label="Sua mensagem" rows="5" placeholder="Sua mensagem" required class="bg-surface border border-white/10 p-4 rounded focus:border-accent focus:ring-1 focus:ring-accent outline-none text-text-high resize-none transition-all"></textarea>
				<button type="submit" class="bg-accent text-background font-bold py-4 rounded hover:brightness-110 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">Enviar Mensagem</button>
			</form>

			<div class="mt-12 text-center">
				<p class="text-text-muted mb-4">Ou se preferir:</p>
				<button id="copyEmail" class="text-accent font-mono text-lg hover:underline group flex items-center gap-2 mx-auto">
					osvaldodecarvalho2005@outlook.com
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
				</button>
				<span id="copyFeedback" class="text-xs text-accent mt-2 block opacity-0 transition-opacity">E-mail copiado!</span>
			</div>
		</section>

		<footer class="py-12 text-center text-text-muted text-sm font-mono border-t border-white/5">
			<p>Construído com Astro & Tailwind • Osvaldo Vasconcelos © 2026</p>
		</footer>
	</main>

	<script>
		// Copy Email fallback
		const copyBtn = document.getElementById('copyEmail');
		const feedback = document.getElementById('copyFeedback');
		
		copyBtn?.addEventListener('click', () => {
			navigator.clipboard.writeText('osvaldodecarvalho2005@outlook.com');
			if (feedback) {
				feedback.style.opacity = '1';
				setTimeout(() => { feedback.style.opacity = '0'; }, 2000);
			}
		});

		// Reveal on Scroll
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('active');
					observer.unobserve(entry.target); // Anima apenas 1 vez
				}
			});
		}, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

		document.querySelectorAll('.reveal').forEach((el) => {
			observer.observe(el);
		});

		// Spotlight Effect
		document.querySelectorAll('.spotlight-card').forEach(card => {
			card.addEventListener('mousemove', e => {
				const rect = card.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				card.style.setProperty('--mouse-x', `${x}px`);
				card.style.setProperty('--mouse-y', `${y}px`);
			});
		});

		// 3D Tilt Effect
		document.querySelectorAll('.tilt-card').forEach(card => {
			card.addEventListener('mousemove', e => {
				const rect = card.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				const centerX = rect.width / 2;
				const centerY = rect.height / 2;
				const rotateX = ((y - centerY) / centerY) * -3;
				const rotateY = ((x - centerX) / centerX) * 3;
				
				card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
			});
			card.addEventListener('mouseleave', () => {
				card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
				card.style.transition = 'transform 0.5s ease-out';
			});
			card.addEventListener('mouseenter', () => {
				card.style.transition = 'transform 0.1s ease-out';
			});
		});

		// Text Scramble Effect (Run once on load)
		const chars = '!<>-_\\\\/[]{}—=+*^?#_';
		document.querySelectorAll('.scramble').forEach(el => {
			const originalText = el.innerText;
			let iterations = 0;
			// Pequeno delay inicial para garantir que o usuário veja o efeito começando
			setTimeout(() => {
				const interval = setInterval(() => {
					el.innerText = originalText.split('').map((letter, index) => {
						if(index < iterations) return originalText[index];
						return chars[Math.floor(Math.random() * chars.length)];
					}).join('');
					if(iterations >= originalText.length) clearInterval(interval);
					iterations += 1 / 2; // Velocidade ajustada para textos grandes
				}, 40);
			}, 300);
		});

		// Theme Switcher with View Transitions
		const themeToggle = document.getElementById('theme-toggle');
		themeToggle?.addEventListener('click', (event) => {
			const isDark = document.documentElement.classList.contains('dark');
			const nextTheme = isDark ? 'light' : 'dark';
			
			// Fallback for browsers that don't support View Transitions API
			if (!document.startViewTransition) {
				document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', nextTheme);
				return;
			}

			// Get click coordinates for the circle origin
			const x = event.clientX;
			const y = event.clientY;
			const endRadius = Math.hypot(
				Math.max(x, innerWidth - x),
				Math.max(y, innerHeight - y)
			);

			const transition = document.startViewTransition(() => {
				document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', nextTheme);
			});

			transition.ready.then(() => {
				const clipPath = [
					`circle(0px at ${x}px ${y}px)`,
					`circle(${endRadius}px at ${x}px ${y}px)`
				];
				
				document.documentElement.animate(
					{
						clipPath: isDark ? clipPath : [...clipPath].reverse(),
					},
					{
						duration: 500,
						easing: 'ease-in-out',
						fill: 'forwards',
						pseudoElement: isDark ? '::view-transition-new(root)' : '::view-transition-old(root)',
					}
				);
			});
		});
	</script>
</Layout>
